{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chojema Image+",
  "version": "0.20.2",
  "identifier": "com.chojema.imageplus",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chojema Image+",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' img: http://img.localhost thumb: http://thumb.localhost data: blob:; media-src 'self' img: http://img.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "Chulwoo Park",
    "copyright": "© 2026 Chulwoo Park",
    "category": "Photography",
    "shortDescription": "Image viewer",
    "license": "MIT",
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "jpe", "jfif", "png", "apng", "gif", "webp", "bmp", "ico", "avif", "tif", "tiff", "heic", "heif"],
        "name": "Image",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
